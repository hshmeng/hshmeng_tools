<Window x:Class="hshmeng_tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HSHMENG_TOOLS" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        Icon="Assets/logo.ico"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- 自定义标题栏 -->
            <RowDefinition Height="*"/>  <!-- 主内容 -->
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <DockPanel Grid.Row="0" Background="White" LastChildFill="True">
            <TextBlock Text="HSHMENG_TOOLS" VerticalAlignment="Center" 
                       Margin="10,0,0,0" FontWeight="Bold" Foreground="#333"/>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="40" Height="40" Content="—" Click="Minimize_Click"
                        Background="Transparent" BorderThickness="0" FontSize="16"
                        ToolTip="最小化"/>
                <Button Width="40" Height="40" Content="▢" Click="MaximizeRestore_Click"
                        Background="Transparent" BorderThickness="0" FontSize="14"
                        ToolTip="最大化/还原"/>
                <Button Width="40" Height="40" Content="✕" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" FontSize="14"
                        Foreground="Red" ToolTip="关闭"/>
            </StackPanel>
        </DockPanel>

        <!-- 左右布局内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- 左侧导航 -->
                <ColumnDefinition Width="*"/>   <!-- 右侧内容 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <StackPanel Background="White">
                <TextBlock Text="HSHMENG" FontSize="30" FontWeight="Bold" 
                           Margin="20,20, 0,20" Foreground="#333"/>
                <ListBox x:Name="NavListBox" BorderThickness="0" Background="White"
                         SelectionChanged="NavListBox_SelectionChanged">
                    <ListBoxItem Content="极域工具" Padding="20,10" FontSize="15" FontWeight="Bold"/>
                    <ListBoxItem Content="扫活工具" Padding="20,10" FontSize="15" FontWeight="Bold"/>
                    <ListBoxItem Content="共享操作" Padding="20,10" FontSize="15" FontWeight="Bold"/>
                    <ListBoxItem Content="帮助" Padding="20,10" FontSize="15" FontWeight="Bold"/>
                    <ListBoxItem Content="设置" Padding="20,10" FontSize="15" FontWeight="Bold"/>
                </ListBox>
            </StackPanel>

            <!-- 右侧内容 -->
            <Frame x:Name="MainFrame" Grid.Column="1" 
                   NavigationUIVisibility="Hidden" Background="#F3F3F3"/>
        </Grid>
    </Grid>
</Window>
